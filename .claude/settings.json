{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(md5sum *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git ls-files *)",
      "Bash(python3 kernel/Lens_validate.py *)",
      "Bash(bash tools/env_check.sh*)",
      "Bash(bash tools/claude-code/frame_check.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
